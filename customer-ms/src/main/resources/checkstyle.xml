<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <!-- Codificación -->
    <property name="charset" value="UTF-8"/>

    <!-- Reglas que van a nivel de Checker -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*"/>
    </module>

    <!-- Agrupador para reglas que van dentro de TreeWalker -->
    <module name="TreeWalker">

        <!-- Estilo de nombres -->
        <module name="PackageName"/>
        <module name="TypeName"/> <!-- Clases y Enums en PascalCase -->
        <module name="MethodName"/> <!-- Métodos en camelCase -->
        <module name="ParameterName"/> <!-- Parámetros en camelCase -->
        <module name="LocalVariableName"/> <!-- Variables en camelCase -->
        <module name="ConstantName"/> <!-- Constantes en MAYÚSCULAS -->

        <!-- Estructura y formato -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="tabWidth" value="4"/>
        </module>
        <module name="WhitespaceAround"/>
        <module name="WhitespaceAfter"/>

        <!-- Bloques -->
        <module name="NeedBraces"/> <!-- Forzar llaves en if/else/for/while -->

        <!-- Importaciones -->
        <module name="UnusedImports"/>
        <module name="AvoidStarImport"/>

        <!-- Comentarios -->
        <module name="JavadocType"/>
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="allowedAnnotations" value="Override, Test"/>
        </module>
    </module>
</module>
